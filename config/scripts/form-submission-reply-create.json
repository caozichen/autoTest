  "id": "form-submission-reply-create",
  "name": "手动创建提报信息",
  "description": "通过后台手动创建提报页面加载前序脚本发布的全题型表单，校验单页创建态、必填与格式边界，填写全部题型并验证唯一创建请求、动态字段载荷、成功详情回显及全部接口和静态资源健康。",
  "directory": "scripts",
  "entryFile": "form-submission-reply-create.ui.spec.mjs",
  "timeoutMs": 300000,
  "enabled": true,
  "requestPath": "/form-activity/submission/preview/reply/create?fid={{FORM_ID}}",
  "inputParameters": [
    {
      "id": "target-form-id",
      "key": "FORM_ID",
      "value": "q3r72J",
      "description": "待手动创建提报的表单 ID，可映射前序创建完整表单脚本输出。"
    },
    {
      "id": "published-form-contract",
      "key": "FORM_CONTRACT",
      "value": "",
